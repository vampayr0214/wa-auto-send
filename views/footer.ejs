    </div>
  </main>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  // Get JWT token from cookie or localStorage
  function getToken() {
    // Try cookie first
    const match = document.cookie.match(/(?:^|;\s*)token=([^;]*)/);
    if (match) return match[1];
    // Fallback to localStorage
    return localStorage.getItem('wa_token');
  }

  // Socket.IO client with JWT auth
  const token = getToken();
  const socket = io({
    auth: { token: token },
    query: { token: token }
  });

  // Mobile nav toggle
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('navToggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('navOverlay');

    if (toggle && sidebar && overlay) {
      toggle.addEventListener('click', () => {
        sidebar.classList.toggle('-translate-x-full');
        overlay.classList.toggle('hidden');
      });

      overlay.addEventListener('click', () => {
        sidebar.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
      });
    }
  });

  // WhatsApp status listener
  socket.on('wa:status', (data) => {
    const badges = document.querySelectorAll('#waStatusBadge');
    const texts = document.querySelectorAll('#waStatusText');
    const dots = document.querySelectorAll('#waDot');
    const qrSections = document.querySelectorAll('#qrSection, #qrContainer');

    badges.forEach(badge => {
      badge.className = badge.className.replace(
        /bg-\w+-900 text-\w+-300/g,
        data.connected ? 'bg-green-900 text-green-300' : 'bg-red-900 text-red-300'
      );
    });

    texts.forEach(text => {
      text.textContent = data.connected ? 'Connected' : 'Disconnected';
    });

    dots.forEach(dot => {
      dot.className = dot.className.replace(
        /bg-\w+-400/g,
        data.connected ? 'bg-green-400' : 'bg-red-400'
      );
    });

    qrSections.forEach(section => {
      if (data.connected) {
        section.classList.add('hidden');
      } else {
        section.classList.remove('hidden');
      }
    });
  });

  socket.on('wa:qr', (dataUrl) => {
    const displays = document.querySelectorAll('#qrDisplay');
    displays.forEach(display => {
      display.innerHTML = `<img src="${dataUrl}" alt="QR Code" class="w-64 h-64">`;
    });
  });

  // Initialize WhatsApp
  let waPollTimer = null;
  function waInit() {
    // Show loading spinner
    const displays = document.querySelectorAll('#qrDisplay');
    displays.forEach(display => {
      display.innerHTML = '<div class="w-64 h-64 flex items-center justify-center"><div class="animate-spin rounded-full h-12 w-12 border-b-2 border-green-400"></div></div>';
    });

    // Emit via socket
    socket.emit('wa:init');

    // Start polling API as fallback (socket may disconnect during browser launch)
    const token = getToken();
    if (waPollTimer) clearInterval(waPollTimer);
    waPollTimer = setInterval(async () => {
      try {
        const res = await fetch('/api/wa/status', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const data = await res.json();
        if (data.qr) {
          displays.forEach(d => {
            d.innerHTML = `<img src="${data.qr}" alt="QR Code" class="w-64 h-64">`;
          });
        }
        if (data.connected) {
          if (waPollTimer) { clearInterval(waPollTimer); waPollTimer = null; }
          // Update UI
          const badges = document.querySelectorAll('#waStatusBadge');
          badges.forEach(b => {
            b.className = b.className.replace(/bg-\w+-900 text-\w+-300/g, 'bg-green-900 text-green-300');
          });
          const texts = document.querySelectorAll('#waStatusText');
          texts.forEach(t => { t.textContent = 'Connected'; });
          const dots = document.querySelectorAll('#waDot');
          dots.forEach(d => { d.className = d.className.replace(/bg-\w+-400/g, 'bg-green-400'); });
          // Hide QR
          document.querySelectorAll('#qrSection, #qrContainer').forEach(s => s.classList.add('hidden'));
        }
      } catch (e) {}
    }, 3000);

    // Stop polling after 5 minutes
    setTimeout(() => { if (waPollTimer) { clearInterval(waPollTimer); waPollTimer = null; } }, 300000);
  }

  // Request status on load and reconnect
  socket.on('connect', () => {
    socket.emit('wa:status_request');
    // If waInit was recently called, re-poll API for QR
    if (waPollTimer) {
      // Already polling, just request fresh status
      socket.emit('wa:status_request');
    }
  });

  socket.on('reconnect', () => {
    socket.emit('wa:status_request');
  });

  // Logout function
  function logout() {
    if (!confirm('Are you sure you want to logout?')) return;
    fetch('/api/auth/logout', { method: 'POST' })
      .then(() => {
        localStorage.removeItem('wa_token');
        window.location.href = '/login';
      })
      .catch(() => {
        localStorage.removeItem('wa_token');
        window.location.href = '/login';
      });
  }
</script>
<script src="/js/app.js"></script>
</body>
</html>
