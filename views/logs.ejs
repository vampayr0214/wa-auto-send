<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sent Logs — WA Auto Send</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <div class="md:hidden fixed top-0 left-0 right-0 z-50 bg-gray-800 border-b border-gray-700 px-4 py-3 flex items-center justify-between">
    <span class="text-lg font-bold text-green-400">WA Auto Send</span>
    <button id="navToggle" class="text-gray-300 hover:text-white">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <%- include('header') %>

  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <h1 class="text-2xl font-bold">Sent Logs</h1>
    <a href="/api/logs/export?status=<%= filters.status %>&dateFrom=<%= filters.dateFrom || '' %>&dateTo=<%= filters.dateTo || '' %>"
       class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium text-sm">
      📥 Export CSV
    </a>
  </div>

  <!-- Filters -->
  <div class="bg-gray-800 rounded-lg p-4 border border-gray-700 mb-6">
    <form method="GET" action="/logs" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
      <div>
        <label class="block text-xs text-gray-400 mb-1">Status</label>
        <select name="status" class="w-full bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-green-400">
          <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
          <option value="success" <%= filters.status === 'success' ? 'selected' : '' %>>Success</option>
          <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed</option>
          <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
        </select>
      </div>
      <div>
        <label class="block text-xs text-gray-400 mb-1">From Date</label>
        <input type="date" name="dateFrom" value="<%= filters.dateFrom || '' %>" class="w-full bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-green-400">
      </div>
      <div>
        <label class="block text-xs text-gray-400 mb-1">To Date</label>
        <input type="date" name="dateTo" value="<%= filters.dateTo || '' %>" class="w-full bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-green-400">
      </div>
      <div class="flex items-end gap-2">
        <button type="submit" class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg text-sm">Filter</button>
        <a href="/logs" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm">Clear</a>
      </div>
    </form>
  </div>

  <!-- Log Table -->
  <div class="bg-gray-800 rounded-lg border border-gray-700 overflow-hidden">
    <div class="p-4 border-b border-gray-700">
      <span class="text-gray-400 text-sm"><%= totalCount %> entries</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="text-left text-gray-400 text-sm border-b border-gray-700">
            <th class="px-4 py-3">Phone</th>
            <th class="px-4 py-3">Name</th>
            <th class="px-4 py-3">Message</th>
            <th class="px-4 py-3">Sent At</th>
            <th class="px-4 py-3">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (logs.length === 0) { %>
            <tr><td colspan="5" class="px-4 py-8 text-center text-gray-500">No logs found</td></tr>
          <% } %>
          <% logs.forEach(l => { %>
            <tr class="border-b border-gray-700 hover:bg-gray-750">
              <td class="px-4 py-3 font-mono text-sm"><%= l.phone %></td>
              <td class="px-4 py-3 text-sm"><%= l.name || '-' %></td>
              <td class="px-4 py-3 text-sm text-gray-400 truncate max-w-xs"><%= l.message_preview || '-' %></td>
              <td class="px-4 py-3 text-sm text-gray-400"><%= l.sent_at %></td>
              <td class="px-4 py-3">
                <% if (l.status === 'success') { %>
                  <span class="px-2 py-1 rounded-full text-xs bg-green-900 text-green-300">Success</span>
                <% } else if (l.status === 'failed') { %>
                  <span class="px-2 py-1 rounded-full text-xs bg-red-900 text-red-300">Failed</span>
                <% } else { %>
                  <span class="px-2 py-1 rounded-full text-xs bg-yellow-900 text-yellow-300"><%= l.status %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="flex justify-center gap-2 mt-6">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="/logs?page=<%= i %>&status=<%= filters.status %>&dateFrom=<%= filters.dateFrom || '' %>&dateTo=<%= filters.dateTo || '' %>"
           class="px-3 py-1 rounded <%= i === page ? 'bg-green-600 text-white' : 'bg-gray-700 text-gray-300 hover:bg-gray-600' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>

  <%- include('footer') %>
</body>
</html>
