<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Send Messages — WA Auto Send</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <div class="md:hidden fixed top-0 left-0 right-0 z-50 bg-gray-800 border-b border-gray-700 px-4 py-3 flex items-center justify-between">
    <span class="text-lg font-bold text-green-400">WA Auto Send</span>
    <button id="navToggle" class="text-gray-300 hover:text-white">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <%- include('header') %>

  <h1 class="text-2xl font-bold mb-6">Send Messages</h1>

  <!-- Connection Status -->
  <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 mb-6">
    <h2 class="text-lg font-semibold mb-4">WhatsApp Connection</h2>
    <div id="waStatusBadge" class="flex items-center gap-2 px-4 py-2 rounded-full inline-flex <%= waStatus.connected ? 'bg-green-900 text-green-300' : 'bg-red-900 text-red-300' %>">
      <span id="waDot" class="w-3 h-3 rounded-full <%= waStatus.connected ? 'bg-green-400' : 'bg-red-400' %>"></span>
      <span id="waStatusText"><%= waStatus.connected ? 'Connected' : 'Disconnected' %></span>
    </div>
    <div id="qrSection" class="mt-4 <%= waStatus.connected ? 'hidden' : '' %>">
      <p class="text-gray-400 mb-3">Scan QR code to connect WhatsApp:</p>
      <div id="qrDisplay" class="bg-white p-4 rounded-lg inline-block">
        <% if (waStatus.qr) { %>
          <img src="<%= waStatus.qr %>" alt="QR Code" class="w-64 h-64">
        <% } else { %>
          <div class="w-64 h-64 flex items-center justify-center text-gray-500">
            <button onclick="waInit()" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium">
              Connect WhatsApp
            </button>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Send Controls -->
  <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 mb-6">
    <h2 class="text-lg font-semibold mb-4">Send Controls</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Template</label>
        <select id="sendTemplate" class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-green-400">
          <% templates.forEach(t => { %>
            <option value="<%= t.id %>" <%= t.is_default ? 'selected' : '' %>><%= t.name %><%= t.is_default ? ' (Default)' : '' %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Limit (blank = all unsent)</label>
        <input type="number" id="sendLimit" min="1" placeholder="<%= unsentCount %> unsent contacts" class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-green-400">
      </div>
      <div class="flex items-end">
        <div class="text-sm text-gray-400">
          <span class="font-bold text-white"><%= unsentCount %></span> contacts ready to send
        </div>
      </div>
    </div>
    <div class="flex flex-wrap gap-3" id="sendButtons">
      <button onclick="startSend()" id="btnStart" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-lg font-medium">
        ▶ Start Sending
      </button>
      <button onclick="pauseSend()" id="btnPause" class="bg-yellow-600 hover:bg-yellow-700 text-white px-6 py-2.5 rounded-lg font-medium hidden">
        ⏸ Pause
      </button>
      <button onclick="resumeSend()" id="btnResume" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg font-medium hidden">
        ▶ Resume
      </button>
      <button onclick="abortSend()" id="btnAbort" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2.5 rounded-lg font-medium hidden">
        ⏹ Stop
      </button>
    </div>
  </div>

  <!-- Progress -->
  <div id="progressSection" class="bg-gray-800 rounded-lg p-6 border border-gray-700 mb-6 hidden">
    <h2 class="text-lg font-semibold mb-4">Progress</h2>
    <div class="mb-4">
      <div class="flex justify-between text-sm text-gray-400 mb-2">
        <span id="progressText">0 / 0 messages</span>
        <span id="progressPercent">0%</span>
      </div>
      <div class="w-full bg-gray-700 rounded-full h-4">
        <div id="progressBar" class="bg-green-500 h-4 rounded-full transition-all duration-300" style="width: 0%"></div>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
      <div class="bg-gray-700 rounded-lg p-3 text-center">
        <div class="text-2xl font-bold text-green-400" id="statSent">0</div>
        <div class="text-xs text-gray-400">Sent</div>
      </div>
      <div class="bg-gray-700 rounded-lg p-3 text-center">
        <div class="text-2xl font-bold text-red-400" id="statFailed">0</div>
        <div class="text-xs text-gray-400">Failed</div>
      </div>
      <div class="bg-gray-700 rounded-lg p-3 text-center">
        <div class="text-2xl font-bold text-yellow-400" id="statTotal">0</div>
        <div class="text-xs text-gray-400">Total</div>
      </div>
      <div class="bg-gray-700 rounded-lg p-3 text-center">
        <div class="text-2xl font-bold text-blue-400" id="statETA">--</div>
        <div class="text-xs text-gray-400">ETA</div>
      </div>
    </div>
  </div>

  <!-- Message Log -->
  <div id="messageLog" class="bg-gray-800 rounded-lg p-6 border border-gray-700 hidden">
    <h2 class="text-lg font-semibold mb-4">Live Messages</h2>
    <div id="logContainer" class="space-y-2 max-h-96 overflow-y-auto">
    </div>
  </div>

  <%- include('footer') %>

  <script>
    let sending = false;

    function startSend() {
      const templateId = document.getElementById('sendTemplate').value;
      const limit = document.getElementById('sendLimit').value;

      if (!templateId) { alert('Select a template'); return; }

      sending = true;
      document.getElementById('progressSection').classList.remove('hidden');
      document.getElementById('messageLog').classList.remove('hidden');
      document.getElementById('logContainer').innerHTML = '';
      document.getElementById('btnStart').classList.add('hidden');
      document.getElementById('btnPause').classList.remove('hidden');
      document.getElementById('btnAbort').classList.remove('hidden');

      socket.emit('send:start', { templateId, limit: limit || null });
    }

    function pauseSend() {
      socket.emit('send:pause');
      document.getElementById('btnPause').classList.add('hidden');
      document.getElementById('btnResume').classList.remove('hidden');
    }

    function resumeSend() {
      socket.emit('send:resume');
      document.getElementById('btnResume').classList.add('hidden');
      document.getElementById('btnPause').classList.remove('hidden');
    }

    function abortSend() {
      if (!confirm('Stop sending?')) return;
      socket.emit('send:abort');
      resetSendUI();
    }

    function resetSendUI() {
      sending = false;
      document.getElementById('btnStart').classList.remove('hidden');
      document.getElementById('btnPause').classList.add('hidden');
      document.getElementById('btnResume').classList.add('hidden');
      document.getElementById('btnAbort').classList.add('hidden');
    }

    // Listen for progress
    socket.on('send:progress', (data) => {
      if (data.sent !== undefined) {
        document.getElementById('statSent').textContent = data.sent;
        document.getElementById('statFailed').textContent = data.failed;
        document.getElementById('statTotal').textContent = data.total;
        document.getElementById('progressText').textContent = `${data.sent + data.failed} / ${data.total} messages`;
        const pct = data.total > 0 ? Math.round(((data.sent + data.failed) / data.total) * 100) : 0;
        document.getElementById('progressPercent').textContent = pct + '%';
        document.getElementById('progressBar').style.width = pct + '%';
      }
      if (data.eta !== undefined) {
        const mins = Math.floor(data.eta / 60);
        const secs = data.eta % 60;
        document.getElementById('statETA').textContent = mins > 0 ? `${mins}m ${secs}s` : `${secs}s`;
      }
    });

    socket.on('send:message', (data) => {
      const container = document.getElementById('logContainer');
      const statusColor = data.status === 'success' ? 'text-green-400' : 'text-red-400';
      const statusIcon = data.status === 'success' ? '✅' : '❌';
      const div = document.createElement('div');
      div.className = 'flex items-center gap-3 p-2 bg-gray-700 rounded text-sm';
      div.innerHTML = `
        <span>${statusIcon}</span>
        <span class="font-mono">${data.phone}</span>
        <span class="text-gray-400">${data.name || ''}</span>
        <span class="${statusColor} ml-auto">${data.status}</span>
      `;
      container.prepend(div);
    });

    socket.on('send:complete', (data) => {
      sending = false;
      resetSendUI();
      document.getElementById('statSent').textContent = data.sent;
      document.getElementById('statFailed').textContent = data.failed;
      document.getElementById('statTotal').textContent = data.total;
      document.getElementById('progressText').textContent = 'Complete!';
      document.getElementById('progressPercent').textContent = '100%';
      document.getElementById('progressBar').style.width = '100%';
      document.getElementById('statETA').textContent = '0s';
    });

    socket.on('send:error', (data) => {
      alert('Send error: ' + data.message);
      resetSendUI();
    });
  </script>
</body>
</html>
